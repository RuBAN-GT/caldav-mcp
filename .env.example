CALDAV_PROVIDER=icloud
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=user@example.com
CALDAV_PASSWORD=app-specific-password
# Optional: one calendar_id from list_calendars, or several separated by commas.
# Leave unset, not blank, to disable the restriction.
# CALDAV_ALLOWED_CALENDAR_ID=opaque-calendar-id-1,opaque-calendar-id-2
CALDAV_MCP_TRANSPORT=stdio
CALDAV_MCP_HOST=0.0.0.0
CALDAV_MCP_PORT=8100
CALDAV_MCP_LOG_LEVEL=INFO
CALDAV_MCP_REQUEST_TIMEOUT_MS=30000
